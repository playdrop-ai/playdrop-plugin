{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "playdrop",
  "version": "1.0.10",
  "description": "Publish, host and share the games you make with AI: turn any HTML5, web or browser game into a public link anyone can play on phone or desktop, and update it without changing the link.",
  "author": {
    "name": "PlayDrop Inc.",
    "email": "support@playdrop.ai",
    "url": "https://www.playdrop.ai"
  },
  "homepage": "https://www.playdrop.ai",
  "repository": "https://github.com/playdrop-ai/playdrop-plugin",
  "license": "MIT",
  "keywords": [
    "playdrop",
    "games",
    "browser-games",
    "html5-games",
    "game-publishing",
    "game-hosting",
    "publish",
    "share",
    "leaderboards",
    "multiplayer",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "PlayDrop",
        "shortDescription": "Publish and share your games",
        "longDescription": "Publish, host and share the games you make with AI: turn any HTML5, web or browser game into a public link anyone can play on phone or desktop, and update it without changing the link.",
        "developerName": "PlayDrop Inc.",
        "category": "Creativity",
        "capabilities": [
          "Write"
        ],
        "defaultPrompt": [
          "Show my PlayDrop games.",
          "Upload my game privately so I can test it.",
          "Publish the game version I just tested."
        ],
        "websiteURL": "https://www.playdrop.ai/docs/connectors",
        "supportURL": "https://www.playdrop.ai/contact",
        "privacyPolicyURL": "https://www.playdrop.ai/legal/privacy",
        "termsOfServiceURL": "https://www.playdrop.ai/legal/terms",
        "composerIcon": "./assets/playdrop-icon-large.png",
        "logo": "./assets/playdrop-icon-large.png"
      }
    }
  }
}
