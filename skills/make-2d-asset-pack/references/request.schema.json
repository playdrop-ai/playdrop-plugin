{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playdrop.ai/schemas/2d-asset-pack-request-v1.json",
  "title": "PlayDrop 2D Asset Sheet Or Pack Request",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "name", "description", "style", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["sheet", "pack"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "style": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "referenceImages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "ownership"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "ownership": { "enum": ["creator-owned", "licensed", "unknown"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sourceFolder": { "type": ["string", "null"] },
    "variants": {
      "type": "object",
      "properties": {
        "large": { "$ref": "#/$defs/variant" },
        "small": { "$ref": "#/$defs/variant" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "license": { "enum": ["CLOSED", "PLAYDROP", "MIT", "CC0"] },
        "visibility": { "enum": ["PRIVATE", "PUBLIC"] },
        "publicationRights": { "enum": ["cleared", "blocked", "private-only"] },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "retryLimits": {
      "type": "object",
      "properties": {
        "fullSheetsPerFamilyMaximum": { "type": "integer", "minimum": 1, "default": 2 },
        "individualRepairsPerAssetMaximum": { "type": "integer", "minimum": 1, "default": 2 }
      },
      "additionalProperties": false
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": ["width", "height", "padding", "contract"],
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "padding": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["id", "name", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "mode": { "enum": ["paired", "large", "small"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
        "matte": {
          "anyOf": [
            { "const": "auto" },
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          ]
        },
        "fallbackMattes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "styleReferenceImages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "ownership"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "ownership": { "enum": ["creator-owned", "licensed", "unknown"] }
            },
            "additionalProperties": false
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/item" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "payloads": {
          "type": "object",
          "properties": {
            "large": { "type": "string", "minLength": 1 },
            "small": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "references": {
          "type": "object",
          "properties": {
            "large": { "type": "string" },
            "small": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
